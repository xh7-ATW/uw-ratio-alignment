{
  "schema_version": 1,
  "experiment_name": "seed42_type_lr_tmuonl",
  "description": "Seed-42 t-MuonL under the same type-specific learning-rate/weight-decay regime as the Muon diagnostic run.",
  "paper_terms": {
    "method": "t-MuonL",
    "learning_rate_regime": "type-specific learning rates",
    "matrix_weight_decay": "type-specific",
    "diagnostic": "loss-only"
  },
  "seed": 42,
  "default_run_dir": "outputs/seed42_type_lr_tmuonl",
  "log_stem": "seed42_type_lr_tmuonl",
  "training": {
    "script": "pipeline/train/train_alignment.py",
    "torchrun": "torchrun",
    "nproc_per_node": 1
  },
  "environment": {
    "MYOPT_SCHEME": "typed_muonl",
    "MYOPT_SAVE_LOG": "1",
    "MYOPT_SAVE_DIAG": "0",
    "MYOPT_SAVE_VAL_LOSS_JSONL": "1",
    "MYOPT_LR": "0.035",
    "MYOPT_WD": "0.025",
    "MYOPT_QKV_LR": "0.025",
    "MYOPT_ATTN_PROJ_LR": "0.030",
    "MYOPT_MLP_FC_LR": "0.035",
    "MYOPT_MLP_PROJ_LR": "0.035",
    "MYOPT_QKV_WD": "0.025",
    "MYOPT_ATTN_PROJ_WD": "0.025",
    "MYOPT_MLP_FC_WD": "0.0375",
    "MYOPT_MLP_PROJ_WD": "0.025",
    "MYOPT_NS_STEPS": "12",
    "MYOPT_NESTEROV": "1",
    "MYOPT_COOLDOWN_FRAC": "0.7",
    "MYOPT_TRAIN_STEPS": "3300",
    "MYOPT_SCHEDULE_STEPS": "3300",
    "MYOPT_VAL_TOKENS": "10485760",
    "MYOPT_MID_VAL_FREQ": "25",
    "MYOPT_MID_VAL_START": "3000",
    "MYOPT_LATE_VAL_FREQ": "10",
    "MYOPT_LATE_VAL_START": "3200",
    "MYOPT_UW_FLOOR_MODE": "off"
  },
  "expected_outputs": [
    "raw/seed42_type_lr_tmuonl.txt",
    "raw/seed42_type_lr_tmuonl_val_loss.jsonl",
    "resolved_config.json"
  ]
}
