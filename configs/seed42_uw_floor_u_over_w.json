    "MYOPT_MLP_FC_LR": "0.0375",
    "MYOPT_MLP_PROJ_LR": "0.0375",
    "MYOPT_QKV_WD": "0",
    "MYOPT_ATTN_PROJ_WD": "0",
    "MYOPT_MLP_FC_WD": "0",
    "MYOPT_MLP_PROJ_WD": "0",
    "MYOPT_NS_STEPS": "12",
    "MYOPT_NESTEROV": "1",
