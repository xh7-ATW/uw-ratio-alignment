    "u_w_floor": "fixed lower bound c=0.35 on pre-learning-rate ||U||_F / ||W||_F"
  },
  "seed": 42,
  "default_run_dir": "runs/uw_floor/seed42_c035_u_over_w/normuon_c035_u_over_w",
