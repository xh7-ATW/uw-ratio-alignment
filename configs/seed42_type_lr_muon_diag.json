{
  "schema_version": 1,
  "experiment_name": "seed42_type_lr_muon_diag",
  "description": "Seed-42 Muon trajectory under the type-specific learning-rate/weight-decay regime, with exact-HVP diagnostics for the type-specific criteria.",
  "paper_terms": {
    "method": "Muon",
    "learning_rate_regime": "type-specific learning rates",
    "matrix_weight_decay": "type-specific",
    "diagnostic": "exact HVP, cross-curvature, train-batch data"
  },
  "seed": 42,
  "default_run_dir": "outputs/seed42_type_lr_muon_diag",
  "log_stem": "seed42_type_lr_muon_diag",
  "training": {
    "script": "pipeline/train/train_alignment.py",
    "torchrun": "torchrun",
    "nproc_per_node": 1
  },
  "environment": {
    "MYOPT_SCHEME": "plain_muon",
    "MYOPT_SAVE_LOG": "1",
    "MYOPT_SAVE_DIAG": "1",
    "MYOPT_DIAG_JSON": "seed42_type_lr_muon_diag_diag.json",
    "MYOPT_SAVE_VAL_LOSS_JSONL": "1",
    "MYOPT_DIAG_MODE": "local_quadratic",
    "MYOPT_DIAG_FREQ": "250",
    "MYOPT_DIAG_MBS": "64",
    "MYOPT_DIAG_GRAD_MBS": "4",
    "MYOPT_LOCAL_QUADRATIC_HVP_MBS": "4",
    "MYOPT_LOCAL_QUADRATIC_DATA_SOURCE": "train_batch",
    "MYOPT_LOCAL_QUADRATIC_CURVATURE": "exact_hvp",
    "MYOPT_LOCAL_QUADRATIC_CROSS_CURVATURE": "1",
    "MYOPT_LOCAL_QUADRATIC_SAVE_CROSS_CURVATURE_MATRIX": "1",
    "MYOPT_LOCAL_QUADRATIC_MAX_BLOCKS": "0",
    "MYOPT_LR": "0.035",
    "MYOPT_WD": "0.025",
    "MYOPT_QKV_LR": "0.025",
    "MYOPT_ATTN_PROJ_LR": "0.030",
    "MYOPT_MLP_FC_LR": "0.035",
    "MYOPT_MLP_PROJ_LR": "0.035",
    "MYOPT_QKV_WD": "0.025",
    "MYOPT_ATTN_PROJ_WD": "0.025",
    "MYOPT_MLP_FC_WD": "0.0375",
    "MYOPT_MLP_PROJ_WD": "0.025",
    "MYOPT_NS_STEPS": "12",
    "MYOPT_NESTEROV": "1",
    "MYOPT_COOLDOWN_FRAC": "0.7",
    "MYOPT_TRAIN_STEPS": "3300",
    "MYOPT_SCHEDULE_STEPS": "3300",
    "MYOPT_VAL_TOKENS": "10485760",
    "MYOPT_MID_VAL_FREQ": "25",
    "MYOPT_MID_VAL_START": "3000",
    "MYOPT_LATE_VAL_FREQ": "10",
    "MYOPT_LATE_VAL_START": "3200",
    "MYOPT_UW_FLOOR_MODE": "off"
  },
  "expected_outputs": [
    "raw/seed42_type_lr_muon_diag.txt",
    "raw/seed42_type_lr_muon_diag_val_loss.jsonl",
    "raw/seed42_type_lr_muon_diag_diag.json",
    "resolved_config.json"
  ]
}
